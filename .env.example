# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Antom Payment（對齊 OpenClaw 專案命名）
ANTOM_CLIENT_ID=SANDBOX_xxxxxxxx
ANTOM_APP_ID=SANDBOX_xxxxxxxx
ANTOM_API_BASE=https://open-sea-global.alipay.com
ANTOM_GATEWAY_URL=https://open-sea-global.alipay.com
ANTOM_API_PATH=/ams/api/v1/payments/pay
ANTOM_PAYMENT_METHOD=ALIPAY_CN
ANTOM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
ANTOM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Webhook URL（Antom 後台 notifyUrl）：
# {NEXT_PUBLIC_APP_URL}/api/webhooks/antom
